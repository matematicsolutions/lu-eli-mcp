                    ],
                    "default": null
                  }
                },
                "type": "object"
              },
              "type": "array"
            },
            "modifies": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "publication_date": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "repeals": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "source_url": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "title": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "title_short": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "type": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "type": "object"
        }
      },
      "sha256": "06868b58a0429b6629b45f596264b5ac35c01c727f38d7771109ed244316b819"
    },
