          "properties": {
            "cites": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "dataset_note": {
              "default": "Legilux (data.legilux.public.lu) serves Luxembourg legislation as jolux RDF over a FRBR model, with full text as Akoma Ntoso XML. It is genuinely ELI-native. There is no HTTP search endpoint, so discovery is by ELI coordinates (no free-text search) - obtain ELIs from legilux.public.lu or from the cites/modifies/repeals links in lu_get_act output.",
              "type": "string"
            },
            "date_document": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "date_entry_in_force": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "eli_path": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
