            "in_force_status": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "languages": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "manifestations": {
              "items": {
                "additionalProperties": true,
                "description": "One downloadable representation of an act (language + format).",
                "properties": {
                  "file_url": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  },
                  "format": {
                    "anyOf": [
                      {
                        "type": "string"
